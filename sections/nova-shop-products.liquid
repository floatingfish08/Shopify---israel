{%- assign product_handles = 'nova-plastic-abutment-for-casting||nova-chrome-cobalt-abutment-ucla||nova-ball-attachment||nova-flat-locator-abutment||nova-angled-titanium-pop-clicq-18||nova-angled-titanium-pop-clicq-30||nova-slim-titanium-healing-abutment||nova-surgical-hand-tools' | split: '||' -%}
{%- assign product_titles = 'Plastic Abutment for Casting||Chrome Cobalt Abutment / UCLA||Ball Attachment||Flat Locator Abutment||Angled Titanium Pop-Clicq — 18°||Angled Titanium Pop-Clicq — 30°||Slim Titanium Healing Abutment||Surgical Hand Tools' | split: '||' -%}
{%- assign product_types = 'Restorative||CAD/CAM & Casting||Overdenture||Overdenture||Multi-unit||Multi-unit||Healing||Surgical' | split: '||' -%}
{%- assign product_images = 'nova-shop-plastic-2.webp||nova-shop-chrome-cobalt.webp||nova-shop-ball-3.webp||nova-shop-flat-locator.webp||nova-shop-pop-clicq-18.webp||nova-shop-pop-clicq-30.webp||nova-shop-healing-slim-4.webp||nova-shop-surgical-driver.webp' | split: '||' -%}
{%- assign product_counts = '2 options||2 options||6 heights||8 heights||4 heights||4 heights||3 heights||2 tools' | split: '||' -%}

<section class="nova-shop color-{{ section.settings.color_scheme }} gradient" style="--nova-section-bg: url('{{ 'nova-bg-products-v1.jpg' | asset_url }}');" aria-labelledby="NovaShopHeading-{{ section.id }}">
  <div class="page-width">
    <header class="nova-shop__heading">
      <div><span class="nova-kicker">Popular components</span><h2 id="NovaShopHeading-{{ section.id }}" class="h1">Shop dental implant components.</h2></div>
      <div><p>Shop eight highlighted families with real NOVA imagery, then browse the expanded catalog for the complete restorative and surgical workflow.</p><a href="{{ routes.all_products_collection_url }}">View 50+ products <span aria-hidden="true">→</span></a><span class="nova-shop__status"><i></i> Live inventory · ready to configure</span></div>
    </header>
    <div class="nova-shop__grid">
      {%- for handle in product_handles -%}
        {%- assign card_product = all_products[handle] -%}
        <article class="nova-shop-card">
          <a class="nova-shop-card__media" href="/products/{{ handle }}" aria-label="Shop {{ product_titles[forloop.index0] | escape }}">
            <span class="nova-shop-card__badge">In stock</span>
            <img src="{{ product_images[forloop.index0] | asset_url }}" alt="{{ product_titles[forloop.index0] | escape }}" width="1200" height="1200" loading="lazy">
          </a>
          <div class="nova-shop-card__body">
            <span class="nova-shop-card__type">{{ product_types[forloop.index0] }}</span>
            <h3><a href="/products/{{ handle }}">{{ product_titles[forloop.index0] }}</a></h3>
            <p>Internal hex · {{ product_counts[forloop.index0] }}</p>
            <div class="nova-shop-card__footer">
              <strong>{%- if card_product != blank -%}{{ card_product.price | money }}{%- else -%}$25.00{%- endif -%}</strong>
              <a class="nova-choose-options" href="/products/{{ handle }}">Choose options <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <div class="nova-shop__assist">
      <div>
        <span class="nova-kicker">Find the exact component</span>
        <h3>Search the full catalog by product name or catalog number.</h3>
        <p>Browse every available configuration, or ask NOVA to confirm platform compatibility before ordering.</p>
      </div>
      <form action="{{ routes.search_url }}" method="get" role="search" class="nova-shop__assist-search">
        <label class="visually-hidden" for="NovaProductSearch-{{ section.id }}">Search NOVA products</label>
        <input id="NovaProductSearch-{{ section.id }}" type="search" name="q" placeholder="Product, SKU or catalog number" autocomplete="off">
        <input type="hidden" name="type" value="product">
        <button type="submit">Search catalog <span aria-hidden="true">→</span></button>
      </form>
      <div class="nova-shop__assist-links">
        <a href="{{ routes.all_products_collection_url }}">Browse all 50+ products <span aria-hidden="true">→</span></a>
        <a href="/pages/contact">Ask a product specialist <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NOVA shop products",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [{ "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }],
  "presets": [{ "name": "NOVA shop products" }]
}
{% endschema %}
