      </a>
    </aside>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-nova-slider]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const slides = [...root.querySelectorAll('[data-nova-slide]')];
    const dots = [...root.querySelectorAll('[data-nova-slider-dot]')];
    let current = 0;
    let timer;
    const show = (next) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        const active = index === current;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
        slide.toggleAttribute('inert', !active);
      });
      dots.forEach((dot, index) => { const active = index === current; dot.classList.toggle('is-active', active); dot.setAttribute('aria-selected', String(active)); });
    };
    const stop = () => clearInterval(timer);
    const restart = () => {
      stop();
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && !document.hidden) {
        timer = setInterval(() => show(current + 1), 6500);
      }
    };
    root.querySelector('[data-nova-slider-prev]').addEventListener('click', () => { show(current - 1); restart(); });
    root.querySelector('[data-nova-slider-next]').addEventListener('click', () => { show(current + 1); restart(); });
    dots.forEach((dot, index) => dot.addEventListener('click', () => { show(index); restart(); }));
    root.addEventListener('pointerenter', stop);
    root.addEventListener('pointerleave', restart);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', (event) => { if (!root.contains(event.relatedTarget)) restart(); });
    document.addEventListener('visibilitychange', () => document.hidden ? stop() : restart());
    show(0);
    restart();
  })();
</script>

{% schema %}
{
  "name": "NOVA homepage slider",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "NOVA homepage slider" }]
}
{% endschema %}
