<section class="nova-hero" data-nova-hero aria-label="NOVA PSI flagship implant">
  <div class="nova-hero__stage" aria-hidden="true">
    <img
      class="nova-hero__visual"
      src="{{ 'nova-hero-editorial-v1.jpg' | asset_url }}"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      alt=""
    >
  </div>
  <div class="page-width nova-hero__content">
    <p class="nova-hero__brand">NOVA</p>
    <h1>The flagship internal-hex implant.</h1>
    <p class="nova-hero__lede">PSI — Ti-6Al-4V, Novitex® surface, immediate-placement capable. Direct from the manufacturer.</p>
    <div class="nova-hero__actions">
      <a class="button button--primary" href="/products/psi-implant-system">Order PSI</a>
      <a class="button button--secondary" href="{{ routes.collections_url }}/implant-systems">Explore systems</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NOVA homepage slider",
  "tag": "section",
  "class": "section section--flush",
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "NOVA homepage slider" }]
}
{% endschema %}
