<section class="nova-marketplace" aria-label="NOVA Implants USA highlights">
  <div class="nova-marketplace__grid page-width">
    <div class="nova-slider" data-nova-hero-slider data-autoplay-delay="5000">
      <div class="nova-slider__track">
        <article class="nova-slider__slide nova-slider__slide--psi is-active" data-nova-hero-slide aria-hidden="false">
          <img src="{{ 'nova-hero-clinical-campaign-v1.jpg' | asset_url }}" width="1844" height="853" loading="eager" fetchpriority="high" alt="Conceptual NOVA clinical campaign featuring titanium implant and restorative components">
          <span class="nova-slider__overlay" aria-hidden="true"></span>
          <div class="page-width nova-slider__content">
            <span class="nova-slider__eyebrow">One Implant System</span>
            <h1>Meet PSI. NOVA’s flagship internal-hex implant.</h1>
            <p>Ti-6Al-4V ELI, NOVA Active surface, tapered self-tapping body and apical cutting threads. The clinical workflow you expect, direct from the manufacturer.</p>
            <div class="nova-slider__actions">
              <a class="button button--primary" href="/products/psi-implant-system">Order PSI</a>
              <a class="button button--secondary" href="https://cdn.shopify.com/s/files/1/0664/1988/4117/files/nova-implants-catalog-2026.pdf?v=1788246709" target="_blank" rel="noopener">Browse catalog</a>
            </div>
          </div>
        </article>

        <article class="nova-slider__slide" data-nova-hero-slide aria-hidden="true" inert>
          <img src="{{ 'nova-hero-workflow-v1.png' | asset_url }}" width="1672" height="941" loading="lazy" alt="Dental professional organizing titanium restorative components into a connected workflow">
          <span class="nova-slider__overlay" aria-hidden="true"></span>
          <div class="page-width nova-slider__content">
            <span class="nova-slider__eyebrow">Connected clinical workflow</span>
            <h2>One internal-hex ecosystem, clearly organized.</h2>
            <p>Move confidently from implant planning to healing, restorative and surgical components using catalog references built for professional selection.</p>
            <div class="nova-slider__actions">
              <a class="button button--primary" href="{{ routes.collections_url }}/implant-systems">Explore implant systems</a>
              <a class="button button--secondary" href="{{ routes.collections_url }}/restorative-components">Shop restorative</a>
            </div>
          </div>
        </article>

        <article class="nova-slider__slide" data-nova-hero-slide aria-hidden="true" inert>
          <img src="{{ 'nova-hero-fulfillment-v1.png' | asset_url }}" width="1672" height="941" loading="lazy" alt="Professional dental components being prepared for careful fulfillment">
          <span class="nova-slider__overlay" aria-hidden="true"></span>
          <div class="page-width nova-slider__content">
            <span class="nova-slider__eyebrow">Professional U.S. fulfillment</span>
            <h2>Clear ordering, careful handling, faster dispatch.</h2>
            <p>Free U.S. shipping with same-day dispatch on eligible in-stock orders, supported by clear product references before checkout.</p>
            <div class="nova-slider__actions">
              <a class="button button--primary" href="{{ routes.all_products_collection_url }}">Shop in-stock products</a>
              <a class="button button--secondary" href="/pages/shipping-delivery">Shipping details</a>
            </div>
          </div>
        </article>

      <div class="nova-slider__controls" aria-label="Hero slideshow controls">
        <button type="button" data-nova-hero-prev aria-label="Show previous slide"><span aria-hidden="true">←</span></button>
        <div class="nova-slider__dots" aria-label="Choose a hero slide">
          <button type="button" class="is-active" data-nova-hero-dot data-slide-index="0" aria-label="Show slide 1" aria-current="true"></button>
          <button type="button" data-nova-hero-dot data-slide-index="1" aria-label="Show slide 2" aria-current="false"></button>
          <button type="button" data-nova-hero-dot data-slide-index="2" aria-label="Show slide 3" aria-current="false"></button>
        </div>
        <button type="button" data-nova-hero-next aria-label="Show next slide"><span aria-hidden="true">→</span></button>
        <button type="button" class="nova-slider__pause" data-nova-hero-pause aria-label="Pause automatic slides" aria-pressed="false"><span aria-hidden="true">Ⅱ</span></button>
      </div>
      <p class="visually-hidden" data-nova-hero-status aria-live="polite"></p>
      </div>

    <div class="nova-hero-assurance" aria-label="NOVA quality and fulfillment standards">
      <div class="page-width nova-hero-assurance__grid">
        <article>
          <span class="nova-hero-assurance__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 5.5 5.8v5.1c0 4.4 2.6 8.1 6.5 9.8 3.9-1.7 6.5-5.4 6.5-9.8V5.8L12 3Z"/><path d="m8.8 11.8 2.1 2.1 4.5-5"/></svg>
          </span>
          <span><strong>FDA 510(k) cleared</strong><small>K150363 implant system</small></span>
        </article>
        <article>
          <span class="nova-hero-assurance__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="10" r="6.5"/><path d="m8.5 15.4-1 5.1 4.5-2 4.5 2-1-5.1"/><path d="m9.3 10.1 1.8 1.8 3.8-4"/></svg>
          </span>
          <span><strong>ISO 13485:2016</strong><small>Certified quality system</small></span>
        </article>
        <article>
          <span class="nova-hero-assurance__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5"/><path d="M3.8 12h16.4M12 3.5c2.4 2.3 3.6 5.1 3.6 8.5S14.4 18.2 12 20.5C9.6 18.2 8.4 15.4 8.4 12S9.6 5.8 12 3.5Z"/><path d="m16.2 7.9 1.1 1.1 2.1-2.3"/></svg>
          </span>
          <span><strong>CE marked</strong><small>Applicable product lines</small></span>
        </article>
        <article>
          <span class="nova-hero-assurance__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="M3 6.5h11.5v10H3zM14.5 10h3.6l2.9 3.2v3.3h-6.5z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/><path d="M5.5 10h5.8M5.5 13h4"/></svg>
          </span>
          <span><strong>Free U.S. shipping</strong><small>Same-day eligible dispatch</small></span>
        </article>
      </div>
    </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NOVA homepage slider",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "NOVA homepage slider" }]
}
{% endschema %}
