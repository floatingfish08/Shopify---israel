{{ 'section-nova-medical.css' | asset_url | stylesheet_tag }}

<section class="nova-marketplace" aria-label="NOVA Implants USA featured products">
  <div class="nova-marketplace__grid page-width">
<div class="nova-slider">
  <div class="nova-slider__track">
    <article class="nova-slider__slide is-active" data-nova-slide aria-hidden="false">
      <img src="{{ 'nova-hero-friendly-v1.webp' | asset_url }}" width="1536" height="1024" loading="eager" fetchpriority="high" alt="NOVA precision dental implant components on a clean clinical background">
      <span class="nova-slider__overlay" aria-hidden="true"></span>
      <div class="page-width nova-slider__content">
        <span class="nova-slider__eyebrow">NOVA Implants USA</span>
        <h1>Precision for every connection.</h1>
        <p>Shop a complete internal-hex workflow—from implant placement and healing to restorative, digital and full-arch solutions.</p>
        <div class="nova-slider__actions"><a class="button button--primary" href="{{ routes.all_products_collection_url }}">Shop the catalog</a><a class="button button--secondary" href="#NovaRegulatory">FDA &amp; quality</a></div>
        <div class="nova-slider__proof" aria-label="Store catalog highlights">
          <span><strong data-nova-count="53">53</strong> products online</span>
          <span><strong>500</strong> units per configuration</span>
          <span><strong>Free</strong> U.S. shipping</span>
        </div>
        <a class="nova-scroll-cue nova-scroll-cue--hero" href="#NovaCatalog"><span>Scroll to shop</span><i aria-hidden="true">↓</i></a>
      </div>
    </article>
    <article class="nova-slider__slide" data-nova-slide aria-hidden="true">
      <img src="{{ 'nova-slide-psi.webp' | asset_url }}" width="1800" height="600" loading="eager" alt="NOVA PSI dental implant system in 6 mm lengths">
      <span class="nova-slider__overlay" aria-hidden="true"></span>
      <div class="page-width nova-slider__content nova-slider__content--compact">
        <span class="nova-slider__eyebrow">PSI implant system</span>
        <h2>PSI implants. One connected ecosystem.</h2>
        <p>Select implant dimensions, then move confidently through the matching restorative workflow.</p>
        <a class="button button--primary" href="{{ routes.all_products_collection_url }}">Explore components</a>
        <div class="nova-slider__proof"><span><strong>5</strong> diameters</span><span><strong>6</strong> lengths</span><span><strong>1</strong> connected system</span></div>
      </div>
    </article>
    <article class="nova-slider__slide" data-nova-slide aria-hidden="true">
      <img src="{{ 'nova-slide-multi-unit.webp' | asset_url }}" width="1800" height="600" loading="eager" alt="NOVA Multi-Unit abutment solutions">
      <span class="nova-slider__overlay" aria-hidden="true"></span>
      <div class="page-width nova-slider__content nova-slider__content--compact">
        <span class="nova-slider__eyebrow">Full-arch workflow</span>
        <h2>Full-arch solutions made precise and simple.</h2>
        <p>Straight and angled components for secure screw-retained restorations.</p>
        <a class="button button--primary" href="{{ routes.collections_url }}/multi-unit-overdenture">Shop multi-unit</a>
        <div class="nova-slider__proof"><span><strong>18°</strong> angled family</span><span><strong>30°</strong> angled family</span><span><strong>Full</strong> arch workflow</span></div>
      </div>
    </article>
  </div>
  <div class="nova-slider__controls page-width">
    <button type="button" data-nova-slider-prev aria-label="Previous slide">←</button>
    <div class="nova-slider__dots" role="tablist" aria-label="Select featured slide">
      <button class="is-active" type="button" data-nova-slider-dot="0" aria-label="Show slide 1" aria-selected="true"></button>
      <button type="button" data-nova-slider-dot="1" aria-label="Show slide 2" aria-selected="false"></button>
      <button type="button" data-nova-slider-dot="2" aria-label="Show slide 3" aria-selected="false"></button>
    </div>
    <button type="button" data-nova-slider-next aria-label="Next slide">→</button>
  </div>
</div>
    <aside class="nova-marketplace__promos" aria-label="Catalog promotions">
      <a class="nova-promo nova-promo--catalog" href="https://cdn.shopify.com/s/files/1/0664/1988/4117/files/nova-implants-catalog-2026.pdf?v=1788246709" target="_blank" rel="noopener">
        <span class="nova-promo__index">01</span>
        <img src="{{ 'nova-category-multi-unit.webp' | asset_url }}" alt="NOVA multi-unit restorative components" width="900" height="650" loading="eager">
        <span class="nova-promo__shade" aria-hidden="true"></span>
        <span class="nova-promo__content"><small>2026 product catalog</small><strong>Every clinical workflow, organized.</strong><span>Open catalog ↗</span></span>
      </a>
      <a class="nova-promo nova-promo--fda" href="https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfpmn/pmn.cfm?ID=K150363" target="_blank" rel="noopener">
        <span class="nova-promo__index">02</span>
        <img src="{{ 'nova-product-psi.webp' | asset_url }}" alt="NOVA PSI dental implant" width="740" height="720" loading="eager">
        <span class="nova-promo__content"><small>U.S. market clearance</small><strong>FDA 510(k) cleared</strong><span>K150363 · Verify record ↗</span></span>
      </a>
    </aside>
  </div>
</section>

<script>
  (() => {
    const root = document.querySelector('[data-nova-slider]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const slides = [...root.querySelectorAll('[data-nova-slide]')];
    const dots = [...root.querySelectorAll('[data-nova-slider-dot]')];
    let current = 0;
    let timer;
    const show = (next) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => { const active = index === current; slide.classList.toggle('is-active', active); slide.setAttribute('aria-hidden', String(!active)); });
      dots.forEach((dot, index) => { const active = index === current; dot.classList.toggle('is-active', active); dot.setAttribute('aria-selected', String(active)); });
    };
    const restart = () => { clearInterval(timer); timer = setInterval(() => show(current + 1), 7000); };
    root.querySelector('[data-nova-slider-prev]').addEventListener('click', () => { show(current - 1); restart(); });
    root.querySelector('[data-nova-slider-next]').addEventListener('click', () => { show(current + 1); restart(); });
    dots.forEach((dot, index) => dot.addEventListener('click', () => { show(index); restart(); }));
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) restart();
  })();
</script>

{% schema %}
{
  "name": "NOVA homepage slider",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "NOVA homepage slider" }]
}
{% endschema %}
