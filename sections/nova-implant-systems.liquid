{{ 'section-nova-medical.css' | asset_url | stylesheet_tag }}

<section id="NovaSystems" class="nova-systems color-{{ section.settings.color_scheme }} gradient" aria-labelledby="NovaSystemsHeading-{{ section.id }}">
  <div class="page-width nova-systems__inner">
    <div class="nova-section-heading">
      <div>
        <span class="nova-kicker">From the Nova product catalog</span>
        <h2 id="NovaSystemsHeading-{{ section.id }}" class="h1">Two implant geometries. One restorative ecosystem.</h2>
      </div>
      <div class="rte">
        <p>Choose the implant body for the clinical plan, then match restorative and surgical components through catalog number, platform and dimensions.</p>
      </div>
    </div>

    <div class="nova-systems__cards">
      <article class="nova-system-card nova-system-card--psi">
        <div class="nova-system-card__topline">
          <span>01 · Tapered body</span>
          <span>Internal hex</span>
        </div>
        <div class="nova-system-card__body">
          <div>
            <h3>PSI Implant System</h3>
            <p>A tapered, self-tapping implant family available across the diameters and lengths listed in the supplied catalog.</p>
          </div>
          <ul role="list">
            <li>Tapered Ti-6Al-4V ELI body</li>
            <li>Apical cutting threads</li>
            <li>Nova Active Surface treatment</li>
          </ul>
        </div>
        <div class="nova-system-card__specs">
          <div><span>Diameters</span><strong>3.3 · 3.75 · 4.2 · 5.0 · 6.0 mm</strong></div>
          <div><span>Lengths</span><strong>6 · 8 · 10 · 11.5 · 13 · 16 mm</strong></div>
        </div>
        <a href="{{ section.settings.psi_link | default: routes.all_products_collection_url }}" class="nova-system-card__link">Review PSI specifications <span aria-hidden="true">→</span></a>
      </article>

      <article class="nova-system-card nova-system-card--pci">
        <div class="nova-system-card__topline">
          <span>02 · Straight wall</span>
          <span>2.5 mm internal hex</span>
        </div>
        <div class="nova-system-card__body">
          <div>
            <h3>PCI Implant System</h3>
            <p>A straight-wall implant family with a self-drilling thread profile and a 2.5 mm internal-hex connection.</p>
          </div>
          <ul role="list">
            <li>Straight-wall Ti-6Al-4V ELI body</li>
            <li>Wide thread design</li>
            <li>Nova Active or NOVIT surface options</li>
          </ul>
        </div>
        <div class="nova-system-card__specs">
          <div><span>Diameters</span><strong>3.3 · 3.75 · 4.2 · 5.0 · 6.0 mm</strong></div>
          <div><span>Lengths</span><strong>6 · 8 · 10 · 11.5 · 13 · 16 mm</strong></div>
        </div>
        <a href="{{ section.settings.pci_link | default: routes.all_products_collection_url }}" class="nova-system-card__link">Review PCI specifications <span aria-hidden="true">→</span></a>
      </article>
    </div>

    <div class="nova-catalog-map">
      <div class="nova-catalog-map__intro">
        <span class="nova-kicker">Restorative catalog</span>
        <h3>Components organized by workflow</h3>
      </div>
      <div class="nova-catalog-map__items">
        <a href="#NovaResources"><strong>Healing</strong><span>Titanium and concave healing abutments</span></a>
        <a href="#NovaResources"><strong>Restorative</strong><span>Titanium, PEEK, zirconia and ball attachments</span></a>
        <a href="#NovaResources"><strong>Impression</strong><span>Open-tray, closed-tray and transfer components</span></a>
        <a href="#NovaResources"><strong>Multi-unit</strong><span>Multi Click straight, angled and bar solutions</span></a>
        <a href="#NovaResources"><strong>Digital</strong><span>Ti bases, scan bodies and pre-milled blanks</span></a>
        <a href="#NovaResources"><strong>Surgical</strong><span>Kits, drills, drivers, ratchets and tools</span></a>
      </div>
    </div>

    <p class="nova-systems__disclaimer">Dimensions shown are consolidated from the supplied 2024 catalog. Confirm the exact catalog number, labeling and current Instructions for Use before ordering or clinical use.</p>
  </div>
</section>

{% schema %}
{
  "name": "Nova implant systems",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "url", "id": "psi_link", "label": "PSI collection link" },
    { "type": "url", "id": "pci_link", "label": "PCI collection link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Nova implant systems" }]
}
{% endschema %}
