<section class="nova-brand-story" aria-labelledby="NovaBrandStory-{{ section.id }}">
  <div class="page-width nova-brand-story__inner">
    <div class="nova-brand-story__media">
      <span class="nova-brand-story__media-label">PSI · Internal hex</span>
      <img src="{{ 'nova-product-psi.webp' | asset_url }}" alt="NOVA PSI tapered dental implant supplied in the NOVA catalog" width="740" height="720" loading="lazy">
    </div>
    <div class="nova-brand-story__content">
      <span class="nova-kicker">One Implant System</span>
      <h2 id="NovaBrandStory-{{ section.id }}">Meet PSI. NOVA’s flagship internal-hex implant.</h2>
      <p>Ti-6Al-4V ELI, NOVA Active surface, tapered self-tapping body and apical cutting threads. The clinical workflow you expect, direct from the manufacturer.</p>
      <a href="/products/psi-implant-system">Order PSI <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NOVA brand story",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [{ "name": "NOVA brand story" }]
}
{% endschema %}
