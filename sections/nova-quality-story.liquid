{{ 'section-nova-medical.css' | asset_url | stylesheet_tag }}

<section class="nova-quality color-{{ section.settings.color_scheme }} gradient" aria-labelledby="NovaQuality-{{ section.id }}">
  <div class="page-width nova-quality__layout">
    <div class="nova-quality__intro">
      <span class="nova-kicker">Verified quality and traceability</span>
      <h2 id="NovaQuality-{{ section.id }}" class="h1">Confidence backed by documented controls.</h2>
      <div class="rte">
        <p>NOVA combines an FDA 510(k)-cleared dental implant system with ISO 13485-certified manufacturing controls and CE-marked product lines. Exact applicability is confirmed on each product label and current Instructions for Use.</p>
      </div>
      <div class="nova-quality__metric" aria-label="Three documented quality pillars">
        <strong data-nova-count="3">3</strong>
        <span>documented pillars<br>of product confidence</span>
      </div>
      <div class="nova-quality__actions">
        <a class="button button--primary" href="https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfpmn/pmn.cfm?ID=K150363" target="_blank" rel="noopener">Verify FDA clearance</a>
        <a class="button button--secondary" href="{{ section.settings.catalog_url | default: '#NovaResources' }}">Review the product catalog</a>
      </div>
    </div>

    <ol class="nova-quality__steps" role="list">
      <li>
        <span class="nova-quality__step-number">01</span>
        <div><strong>FDA 510(k) K150363</strong><p>The NOVA Dental Implants System received a substantially equivalent decision on June 29, 2015.</p></div>
      </li>
      <li>
        <span class="nova-quality__step-number">02</span>
        <div><strong>ISO 13485:2016</strong><p>The supplied certificate documents NOVA’s medical-device quality management system.</p></div>
      </li>
      <li>
        <span class="nova-quality__step-number">03</span>
        <div><strong>CE-marked product lines</strong><p>Verify the current CE marking, catalog number and applicable IFU for the exact item ordered.</p></div>
      </li>
    </ol>

    <aside class="nova-quality__certificate" aria-label="FDA clearance summary" data-nova-depth>
      <div class="nova-quality__seal" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="28" stroke="currentColor"/><path d="m19 33 8 8 18-20" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div>
        <span>U.S. medical-device clearance</span>
        <strong>FDA 510(k) K150363</strong>
        <p>NOVA Dental Implants System · Class II · DZE / NHA</p>
      </div>
    </aside>

    <p class="nova-quality__notice"><strong>Professional-use notice:</strong> Product selection and clinical use require appropriate training. Always consult the current product label and applicable Instructions for Use.</p>
  </div>
</section>

{% schema %}
{
  "name": "Nova ordering and quality",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "url", "id": "catalog_url", "label": "Catalog link" },
    { "type": "url", "id": "contact_url", "label": "Compatibility contact link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "presets": [{ "name": "Nova ordering and quality" }]
}
{% endschema %}
