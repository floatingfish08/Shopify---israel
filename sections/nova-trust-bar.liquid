<section class="nova-trust color-{{ section.settings.color_scheme }} gradient" aria-label="Quality and service standards">
  <div class="nova-trust__grid page-width">
    {%- for block in section.blocks -%}
      <div class="nova-trust__item" {{ block.shopify_attributes }}>
        <span class="nova-trust__number">0{{ forloop.index }}</span>
        <span class="nova-trust__icon" aria-hidden="true">
          {%- case block.settings.icon -%}
            {%- when 'certificate' -%}
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z"/><path d="m8.5 14.9-1 6.1 4.5-2 4.5 2-1-6.1"/><path d="m9.6 9.1 1.5 1.5 3.4-3.4"/></svg>
            {%- when 'shield' -%}
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 5 6v5c0 4.5 2.8 8.3 7 10 4.2-1.7 7-5.5 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-5"/></svg>
            {%- when 'sterile' -%}
              <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8"/><path d="M12 7v10M7 12h10M8.5 8.5l7 7M15.5 8.5l-7 7"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none"><path d="M3 7h11v10H3zM14 10h4l3 3v4h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
          {%- endcase -%}
        </span>
        <span><strong>{{ block.settings.heading | escape }}</strong>{{ block.settings.text | escape }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Nova trust bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "certificate",
          "options": [
            { "value": "certificate", "label": "Certificate" },
            { "value": "shield", "label": "Shield" },
            { "value": "sterile", "label": "Sterile" },
            { "value": "shipping", "label": "Shipping" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "ISO 13485:2016" },
        { "type": "text", "id": "text", "label": "Supporting text", "default": "Certified quality system" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nova trust bar",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "certificate", "heading": "ISO 13485:2016", "text": "Certified quality system" } },
        { "type": "trust_item", "settings": { "icon": "shield", "heading": "Controlled IFU", "text": "Safety information available" } },
        { "type": "trust_item", "settings": { "icon": "sterile", "heading": "Gamma sterilized", "text": "Implants supplied sterile" } },
        { "type": "trust_item", "settings": { "icon": "shipping", "heading": "Tracked delivery", "text": "International service from Israel" } }
      ]
    }
  ]
}
{% endschema %}
