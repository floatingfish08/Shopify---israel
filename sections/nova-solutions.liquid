{{ 'section-nova-medical.css' | asset_url | stylesheet_tag }}

<section class="nova-solutions color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="nova-section-heading">
      <div>
        <span class="nova-kicker">{{ section.settings.eyebrow | escape }}</span>
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="rte">{{ section.settings.text }}</div>
    </div>

    <div class="nova-solutions__grid">
      {%- for block in section.blocks -%}
        <a class="nova-solution-card" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <span class="nova-solution-card__number">0{{ forloop.index }}</span>
          <div>
            <h3>{{ block.settings.heading | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </div>
          <span class="nova-solution-card__arrow" aria-hidden="true">→</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Nova product solutions",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by clinical workflow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A complete internal-hex system" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Move from placement to final restoration with components organized around the way clinicians work.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ],
  "blocks": [
    {
      "type": "solution",
      "name": "Solution",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Implant systems" },
        { "type": "text", "id": "text", "label": "Text", "default": "PSI and PCI implant families" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nova product solutions",
      "blocks": [
        { "type": "solution", "settings": { "heading": "Implant systems", "text": "PSI and PCI internal-hex implants" } },
        { "type": "solution", "settings": { "heading": "Healing components", "text": "Titanium healing abutments" } },
        { "type": "solution", "settings": { "heading": "Restorative solutions", "text": "Straight, angled and temporary abutments" } },
        { "type": "solution", "settings": { "heading": "Digital workflow", "text": "CAD/CAM bases, scan bodies and blanks" } },
        { "type": "solution", "settings": { "heading": "Multi-unit solutions", "text": "Multi Click components and kits" } },
        { "type": "solution", "settings": { "heading": "Surgical instruments", "text": "Kits, drills, drivers and tools" } }
      ]
    }
  ]
}
{% endschema %}
