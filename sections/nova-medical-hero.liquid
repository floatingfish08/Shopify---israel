<section class="nova-hero color-{{ section.settings.color_scheme }} gradient" aria-labelledby="NovaHero-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2400
      | image_tag:
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        class: 'nova-hero__backdrop',
        alt: section.settings.image.alt
    }}
  {%- else -%}
    <img
      class="nova-hero__backdrop"
      src="{{ 'nova-implant-hero-v2.webp' | asset_url }}"
      width="1536"
      height="1024"
      loading="eager"
      fetchpriority="high"
      alt="Precision-machined dental implant components in a studio setting"
    >
  {%- endif -%}
  <div class="nova-hero__grid page-width">
    <div class="nova-hero__content">
      <div class="nova-hero__eyebrow">
        <span class="nova-status-dot" aria-hidden="true"></span>
        {{ section.settings.eyebrow | escape }}
      </div>
      <h1 id="NovaHero-{{ section.id }}" class="nova-hero__title">{{ section.settings.heading | escape }}</h1>
      <div class="nova-hero__text rte">{{ section.settings.text }}</div>

      <div class="nova-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="button button--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
            {{ section.settings.primary_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="button button--secondary" href="{{ section.settings.secondary_link | default: '#NovaResources' }}">
            {{ section.settings.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <ul class="nova-hero__proof" role="list">
        <li><svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Internal hex platform</span></li>
        <li><svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Ti-6Al-4V ELI titanium</span></li>
        <li><svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Professional clinical use</span></li>
      </ul>
    </div>

    <div class="nova-hero__card">
      <span class="nova-hero__card-label">Quality system</span>
      <strong>ISO 13485:2016</strong>
      <span>Registration IL-99180 · valid through Aug 2027</span>
    </div>

    <div class="nova-hero__stats" aria-label="Catalog overview">
      <div><strong>52</strong><span>Product families</span></div>
      <div><strong>228</strong><span>Configurations</span></div>
      <div><strong>7</strong><span>Clinical categories</span></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Nova medical hero",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Precision implant systems for trained clinicians"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Clinical confidence, engineered into every connection."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Explore internal-hex implant systems, restorative components and surgical solutions manufactured under an ISO 13485 quality system.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero product image"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop implant systems"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "View clinical resources"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ],
  "presets": [{ "name": "Nova medical hero" }]
}
{% endschema %}
