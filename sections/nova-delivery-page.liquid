<section class="nova-delivery nova-delivery--gdt" aria-labelledby="NovaDeliveryTitle-{{ section.id }}">
  <div class="nova-delivery-gdt__hero">
    <img src="{{ 'nova-delivery-fulfillment-v1.webp' | asset_url }}" alt="A medical-device order being prepared in a clean fulfillment workspace" width="1792" height="1024" loading="eager" fetchpriority="high">
    <div class="nova-delivery-gdt__shade"></div>
    <div class="page-width nova-delivery-gdt__hero-copy">
      <span class="nova-kicker">NOVA Implants USA</span>
      <h1 id="NovaDeliveryTitle-{{ section.id }}">Shipping Information</h1>
      <p>Our fulfillment team prepares eligible in-stock orders for same-day dispatch. Select the available shipping service at checkout and follow the tracking link sent when your order is on its way.</p>
      <div class="nova-delivery-gdt__actions">
        <a class="button button--primary" href="{{ routes.all_products_collection_url }}">Shop products</a>
        <a class="nova-delivery-gdt__text-link" href="/pages/contact">Ask about an order <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <div class="page-width nova-delivery-gdt__body">
    <section class="nova-delivery-gdt__intro" aria-labelledby="NovaDeliveryMethod-{{ section.id }}">
      <div><span class="nova-kicker">Fast, carefully prepared orders</span><h2 id="NovaDeliveryMethod-{{ section.id }}">Efficient shipping method</h2></div>
      <div class="nova-delivery-gdt__intro-copy">
        <p>NOVA provides free shipping on eligible U.S. orders and same-day dispatch for qualifying products that are in stock. Final service availability and delivery estimates are confirmed during checkout.</p>
        <p>Complete and accurate shipping, email and telephone details help us process the order without unnecessary delays. If an item is unavailable or requires clarification, our team will contact you before fulfillment continues.</p>
      </div>
    </section>

    <section class="nova-delivery-gdt__methods" aria-labelledby="NovaDeliveryOptions-{{ section.id }}">
      <header>
        <span class="nova-kicker">Available at checkout</span>
        <h2 id="NovaDeliveryOptions-{{ section.id }}">Select your shipping method</h2>
        <p>The exact carrier and estimated arrival depend on destination, inventory and the services available for the order.</p>
      </header>
      <div class="nova-delivery-gdt__table-wrap">
        <table>
          <thead><tr><th>Shipping service</th><th>Shipping cost</th><th>Processing and delivery</th></tr></thead>
          <tbody>
            <tr><td><strong>Standard U.S. shipping</strong><small>Eligible domestic orders</small></td><td><strong>Free</strong><small>No shipping charge on qualifying orders</small></td><td><strong>Same-day dispatch eligible</strong><small>For qualifying in-stock orders</small></td></tr>
            <tr><td><strong>Other available services</strong><small>Shown for the delivery address</small></td><td><strong>Calculated at checkout</strong><small>Confirmed before the order is placed</small></td><td><strong>Estimate shown at checkout</strong><small>Timing varies by service and destination</small></td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="nova-delivery-gdt__gallery" aria-label="NOVA order fulfillment">
      <figure>
        <img src="{{ 'nova-delivery-careful-packing-v1.webp' | asset_url }}" alt="A professional carefully packing sealed medical-device cartons" width="1536" height="1024" loading="lazy">
        <figcaption><span>01 / Preparation</span><strong>Carefully packed</strong><p>Each order is reviewed and prepared for secure carrier handoff.</p></figcaption>
      </figure>
      <figure>
        <img src="{{ 'nova-delivery-dispatch-v1.webp' | asset_url }}" alt="Prepared parcels ready for collection in a clean fulfillment area" width="1536" height="1024" loading="lazy">
        <figcaption><span>02 / Dispatch</span><strong>Ready to move</strong><p>Tracking details follow when the shipment enters the carrier network.</p></figcaption>
      </figure>
    </section>

    <section class="nova-delivery-gdt__process" aria-labelledby="NovaDeliveryProcess-{{ section.id }}">
      <figure class="nova-delivery-gdt__process-image">
        <img src="{{ 'nova-delivery-dispatch-v1.webp' | asset_url }}" alt="Prepared parcels ready for carrier collection" width="1536" height="1024" loading="lazy">
        <figcaption>Orders prepared for carrier handoff</figcaption>
      </figure>
      <div>
        <span class="nova-kicker">From cart to clinic</span>
        <h2 id="NovaDeliveryProcess-{{ section.id }}">Prepared, dispatched and tracked</h2>
        <ol>
          <li><strong>Order received</strong><p>Your confirmation records the selected products and delivery details.</p></li>
          <li><strong>Availability checked</strong><p>We verify inventory and contact you if an item or order detail needs attention.</p></li>
          <li><strong>Tracking provided</strong><p>A tracking link is shared after dispatch and may activate after the carrier’s first scan.</p></li>
        </ol>
      </div>
    </section>

    <section class="nova-delivery-gdt__guidelines" aria-labelledby="NovaDeliveryGuidelines-{{ section.id }}">
      <div><span class="nova-kicker">Before placing your order</span><h2 id="NovaDeliveryGuidelines-{{ section.id }}">Shipping guidelines</h2></div>
      <ul>
        <li><strong>Tracking details</strong><span>Tracking information is sent as soon as it becomes available after dispatch.</span></li>
        <li><strong>Unavailable products</strong><span>We will contact you to review the available options if an ordered item cannot be fulfilled immediately.</span></li>
        <li><strong>Correct contact details</strong><span>Provide an accurate email address, telephone number and complete delivery address.</span></li>
        <li><strong>Order accuracy</strong><span>Confirm product compatibility, dimensions and catalog numbers before checkout.</span></li>
        <li><strong>Address changes</strong><span>Contact NOVA promptly; changes may not be possible after carrier handoff.</span></li>
        <li><strong>Delivery estimates</strong><span>Arrival timing may change because of inventory, destination or carrier conditions.</span></li>
      </ul>
    </section>

    <section class="nova-delivery-gdt__faq" aria-labelledby="NovaDeliveryFaq-{{ section.id }}">
      <header><span class="nova-kicker">Shipping support</span><h2 id="NovaDeliveryFaq-{{ section.id }}">Frequently asked questions</h2></header>
      <div>
        <details open><summary>How do I track my order?</summary><p>Open the tracking link sent after dispatch. Carrier updates can take a short time to appear after the first scan.</p></details>
        <details><summary>Which orders qualify for same-day dispatch?</summary><p>Same-day dispatch applies to eligible in-stock orders. Orders needing availability, address or compatibility clarification can require additional processing.</p></details>
        <details><summary>What if a product is unavailable?</summary><p>The NOVA team will contact you using the details submitted with the order so you can review the available options.</p></details>
        <details><summary>Are delivery dates guaranteed?</summary><p>No. Delivery estimates depend on inventory, destination, carrier operations and the service selected at checkout.</p></details>
      </div>
    </section>
  </div>
</section>

{% schema %}
{
  "name": "NOVA delivery page",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [{ "name": "NOVA delivery page" }]
}
{% endschema %}
