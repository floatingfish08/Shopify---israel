{{ 'section-nova-quick-order.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nova-quick-order.js' | asset_url }}" defer="defer"></script>

{% if page.handle == 'quick-order' or template.suffix == 'quick-order' %}
<section class="nova-quick-order" data-nova-quick-order>
  <div class="nova-quick-order__hero">
    <div class="page-width">
      <nav class="nova-quick-order__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">→</span><span>Quick order</span>
      </nav>
      <span class="nova-page-kicker">Professional ordering</span>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p>{{ section.settings.intro | escape }}</p>
      <div class="nova-quick-order__benefits" aria-label="Ordering benefits">
        <span><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z"></path><circle cx="7" cy="19" r="2"></circle><circle cx="18" cy="19" r="2"></circle></svg><b>Free U.S. shipping</b></span>
        <span><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 2.5 2.5L16 9"></path></svg><b>Same-day eligible dispatch</b></span>
        <span><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg><b>Secure checkout</b></span>
      </div>
    </div>
  </div>

  <div class="page-width nova-quick-order__workspace">
    <div class="nova-quick-order__tools">
      <label class="nova-quick-order__search">
        <span class="visually-hidden">Search products or catalog numbers</span>
        <svg aria-hidden="true" viewBox="0 0 20 20"><circle cx="8.5" cy="8.5" r="5.7"></circle><path d="m13 13 4 4"></path></svg>
        <input type="search" placeholder="Search product, SKU or catalog number" data-quick-search>
      </label>
      <label class="nova-quick-order__filter">
        <span>Product type</span>
        <select data-quick-type>
          <option value="">All products</option>
          {%- assign product_types = collections.all.products | map: 'type' | compact | uniq | sort -%}
          {%- for product_type in product_types -%}
            {%- if product_type != blank -%}<option value="{{ product_type | handleize }}">{{ product_type | escape }}</option>{%- endif -%}
          {%- endfor -%}
        </select>
      </label>
      <div class="nova-quick-order__result"><strong data-quick-visible>0</strong><span>products shown</span></div>
    </div>

    <div class="nova-quick-order__status" role="status" aria-live="polite" data-quick-status></div>

    <div class="nova-quick-order__list" data-quick-list>
      {% paginate collections.all.products by 50 %}
        {%- for product in collections.all.products -%}
          {%- assign selected_variant = product.selected_or_first_available_variant -%}
          {%- assign variant_skus = product.variants | map: 'sku' | join: ' ' -%}
          <article class="nova-quick-row" data-quick-row data-search="{{ product.title | append: ' ' | append: product.type | append: ' ' | append: product.vendor | append: ' ' | append: product.tags | append: ' ' | append: variant_skus | downcase | escape }}" data-type="{{ product.type | handleize }}">
            <a class="nova-quick-row__media" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '120,180,240,320', alt: product.featured_image.alt | default: product.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="nova-quick-row__identity">
              {%- if product.type != blank -%}<span>{{ product.type | escape }}</span>{%- endif -%}
              <h2><a href="{{ product.url }}">{{ product.title | escape }}</a></h2>
              <p>Catalog no. <b data-quick-sku>{{ selected_variant.sku | default: '—' | escape }}</b></p>
            </div>
            <div class="nova-quick-row__variant">
              <label for="QuickVariant-{{ section.id }}-{{ product.id }}">Configuration</label>
              <select id="QuickVariant-{{ section.id }}-{{ product.id }}" data-quick-variant>
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-sku="{{ variant.sku | escape }}" data-available="{{ variant.available }}" {% if variant.id == selected_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
              <span class="nova-quick-row__availability" data-quick-availability>{% if selected_variant.available %}<i></i> In stock{% else %}Sold out{% endif %}</span>
            </div>
            <div class="nova-quick-row__price">
              <span>Unit price</span>
              <strong data-quick-price>{{ selected_variant.price | money }}</strong>
            </div>
            <div class="nova-quick-row__purchase">
              <label for="QuickQuantity-{{ section.id }}-{{ product.id }}">Quantity</label>
              <div class="nova-quick-row__quantity">
                <button type="button" data-quick-minus aria-label="Decrease quantity">−</button>
                <input id="QuickQuantity-{{ section.id }}-{{ product.id }}" type="number" value="0" min="0" max="999" inputmode="numeric" data-quick-quantity>
                <button type="button" data-quick-plus aria-label="Increase quantity">+</button>
              </div>
              <button class="nova-quick-row__add" type="button" data-quick-add {% unless selected_variant.available %}disabled{% endunless %}>Add</button>
            </div>
          </article>
        {%- else -%}
          <div class="nova-quick-order__empty"><h2>No products available</h2><p>Add active products to the store to use Quick Order.</p></div>
        {%- endfor -%}
        {%- if paginate.pages > 1 -%}
          <p class="nova-quick-order__limit">Showing the first 50 products. Use search or the catalog collections to narrow your order.</p>
        {%- endif -%}
      {% endpaginate %}
    </div>
    <div class="nova-quick-order__no-results" hidden data-quick-empty><h2>No matching products</h2><p>Try a product name, catalog number or another product type.</p></div>
  </div>

  <aside class="nova-quick-order__summary" data-quick-summary>
    <div class="page-width">
      <div><span>Order summary</span><strong><b data-quick-count>0</b> items · <b data-quick-total>{{ 0 | money }}</b></strong></div>
      <button type="button" data-quick-add-all disabled>Add all to cart <span aria-hidden="true">→</span></button>
    </div>
  </aside>
</section>
{% endif %}

{% schema %}
{
  "name": "NOVA quick order",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Quick order" },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Find NOVA components by product name, catalog number or system. Select a configuration, set quantities and add the complete order to your cart." }
  ],
  "presets": [{ "name": "NOVA quick order" }]
}
{% endschema %}
