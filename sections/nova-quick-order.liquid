{{ 'section-nova-quick-order.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nova-quick-order.js' | asset_url }}" defer="defer"></script>

{% if page.handle == 'quick-order' or template.suffix == 'quick-order' %}
<section class="nova-quick-order" data-nova-quick-order>
  <header class="nova-quick-order__hero" style="--quick-hero-image:url('{{ 'nova-hero-workflow-v1.png' | asset_url }}')">
    <div class="page-width"><h1>{{ section.settings.heading | escape }}</h1></div>
  </header>

  <div class="page-width nova-quick-order__workspace">
    <div class="nova-quick-order__intro">
      <h2>Quick Order Dental Implants &amp; Prosthetics</h2>
      <p>{{ section.settings.intro | escape }}</p>
    </div>

    <section class="nova-quick-order__tools" aria-label="Quick order filters">
      <label class="nova-quick-order__search">
        <span class="visually-hidden">Search products or catalog numbers</span>
        <svg aria-hidden="true" viewBox="0 0 20 20"><circle cx="8.5" cy="8.5" r="5.7"></circle><path d="m13 13 4 4"></path></svg>
        <input type="search" placeholder="Search… (title, product type, tags or SKU)" data-quick-search>
        <button type="button" aria-label="Clear search" data-quick-clear hidden>×</button>
      </label>
      <div class="nova-quick-filter" data-quick-filter-group="connection">
        <strong>Connection</strong>
        <div><button type="button" class="is-active" data-quick-filter="">All</button><button type="button" data-quick-filter="internal-hexagon">Internal Hexagon</button><button type="button" data-quick-filter="conical-connection">Conical Connection</button></div>
      </div>
      <div class="nova-quick-filter" data-quick-filter-group="type">
        <strong>Product type</strong>
        <div>
          <button type="button" class="is-active" data-quick-filter="">All</button>
          {%- assign product_types = collections.all.products | map: 'type' | compact | uniq | sort -%}
          {%- for product_type in product_types -%}{%- if product_type != blank -%}<button type="button" data-quick-filter="{{ product_type | handleize }}">{{ product_type | escape }}</button>{%- endif -%}{%- endfor -%}
        </div>
      </div>
      <p class="nova-quick-order__result"><strong data-quick-visible>0</strong> of <span data-quick-total-products>0</span> products</p>
    </section>

    <div class="nova-quick-order__status" role="status" aria-live="polite" data-quick-status></div>
    <div class="nova-quick-order__layout">
      <div class="nova-quick-order__catalog">
        <div class="nova-quick-order__list" data-quick-list>
          {% paginate collections.all.products by 50 %}
            {%- for product in collections.all.products -%}
              {%- assign selected_variant = product.selected_or_first_available_variant -%}
              {%- assign variant_skus = product.variants | map: 'sku' | join: ' ' -%}
              {%- assign searchable = product.title | append: ' ' | append: product.type | append: ' ' | append: product.vendor | append: ' ' | append: product.tags | append: ' ' | append: variant_skus | downcase -%}
              {%- if searchable contains 'conical' -%}{%- assign connection = 'conical-connection' -%}{%- else -%}{%- assign connection = 'internal-hexagon' -%}{%- endif -%}
              <article class="nova-quick-row" data-quick-row data-search="{{ searchable | escape }}" data-type="{{ product.type | handleize }}" data-connection="{{ connection }}" data-title="{{ product.title | escape }}">
                <div class="nova-quick-row__summary">
                  <a class="nova-quick-row__media" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                    {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '100,160,240', alt: product.featured_image.alt | default: product.title }}{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
                  </a>
                  <div class="nova-quick-row__identity"><h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><strong data-quick-price>{{ selected_variant.price | money }}</strong></div>
                  <button class="nova-quick-row__toggle" type="button" aria-expanded="false" data-quick-toggle>Select Options <span aria-hidden="true">⌄</span></button>
                </div>
                <div class="nova-quick-row__details" data-quick-details hidden>
                  <div class="nova-quick-row__variant">
                    <label for="QuickVariant-{{ section.id }}-{{ product.id }}">Configuration</label>
                    <select id="QuickVariant-{{ section.id }}-{{ product.id }}" data-quick-variant>
                      {%- for variant in product.variants -%}<option value="{{ variant.id }}" data-price="{{ variant.price }}" data-sku="{{ variant.sku | escape }}" data-available="{{ variant.available }}" {% if variant.id == selected_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}</option>{%- endfor -%}
                    </select>
                  </div>
                  <dl class="nova-quick-row__meta">
                    <div><dt>SKU</dt><dd data-quick-sku>{{ selected_variant.sku | default: '—' | escape }}</dd></div>
                    <div><dt>Unit price</dt><dd data-quick-unit-price>{{ selected_variant.price | money }}</dd></div>
                    <div><dt>Availability</dt><dd class="nova-quick-row__availability" data-quick-availability>{% if selected_variant.available %}<i></i> In stock{% else %}Sold out{% endif %}</dd></div>
                  </dl>
                  <div class="nova-quick-row__purchase">
                    <label for="QuickQuantity-{{ section.id }}-{{ product.id }}">Quantity</label>
                    <div class="nova-quick-row__quantity"><button type="button" data-quick-minus aria-label="Decrease quantity">−</button><input id="QuickQuantity-{{ section.id }}-{{ product.id }}" type="number" value="0" min="0" max="999" inputmode="numeric" data-quick-quantity><button type="button" data-quick-plus aria-label="Increase quantity">+</button></div>
                    <button class="nova-quick-row__add" type="button" data-quick-add {% unless selected_variant.available %}disabled{% endunless %}>Add to order</button>
                  </div>
                </div>
              </article>
            {%- else -%}<div class="nova-quick-order__empty"><h2>No products available</h2><p>Add active products to the store to use Quick Order.</p></div>{%- endfor -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}" hidden data-quick-next-page>Load more products</a>{%- endif -%}
          {% endpaginate %}
        </div>
        <div class="nova-quick-order__no-results" hidden data-quick-empty><h2>No matching products</h2><p>Try a product name, catalog number or another product type.</p></div>
      </div>
      <aside class="nova-quick-order__summary" data-quick-summary>
        <header><strong>Order Summary</strong><span><b data-quick-count>0</b> items</span></header>
        <div class="nova-quick-order__summary-empty" data-quick-summary-empty>No items yet. Select a product, choose a configuration and set a quantity.</div>
        <div class="nova-quick-order__summary-lines" data-quick-summary-lines></div>
        <div class="nova-quick-order__summary-total"><span>Subtotal</span><strong data-quick-total>{{ 0 | money }}</strong></div>
        <p>Free U.S. shipping</p>
        <button type="button" data-quick-add-all disabled>Add All to Cart <span aria-hidden="true">→</span></button>
      </aside>
    </div>
  </div>
</section>
{% endif %}

{% schema %}
{"name":"NOVA quick order","tag":"section","class":"section","settings":[{"type":"text","id":"heading","label":"Heading","default":"Quick Order"},{"type":"textarea","id":"intro","label":"Introduction","default":"Search the NOVA catalog, select configurations and build a complete professional order from one page."}],"presets":[{"name":"NOVA quick order"}]}
{% endschema %}
