<section id="NovaRegulatory" class="nova-regulatory color-{{ section.settings.color_scheme }}" aria-labelledby="NovaRegulatoryHeading-{{ section.id }}">
  <div class="page-width">
    <header class="nova-regulatory__header">
      <span class="nova-kicker">U.S. market clearance</span>
      <h2 id="NovaRegulatoryHeading-{{ section.id }}">Clearance you can verify.</h2>
      <p>Regulatory documentation for licensed dental professionals and purchasing teams.</p>
      <a class="nova-regulatory__link" href="https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfpmn/pmn.cfm?ID=K150363" target="_blank" rel="noopener">View FDA record K150363 <span aria-hidden="true">↗</span></a>
    </header>

    <div class="nova-regulatory__grid">
      <article>
        <span>01</span>
        <strong>FDA 510(k)</strong>
        <p>Class II endosseous implant system · decision dated June 29, 2015.</p>
      </article>
      <article>
        <span>02</span>
        <strong>ISO 13485:2016</strong>
        <p>Certified medical-device quality management · IL-99180.</p>
      </article>
      <article>
        <span>03</span>
        <strong>Professional use</strong>
        <p>Intended for trained and licensed dental professionals.</p>
      </article>
    </div>
    <p class="nova-regulatory__note">“FDA cleared” refers to the NOVA Dental Implants System covered by K150363. Always verify the label and IFU for the exact item ordered.</p>
  </div>
</section>

{% schema %}
{
  "name": "NOVA regulatory focus",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [{ "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }],
  "presets": [{ "name": "NOVA regulatory focus" }]
}
{% endschema %}
