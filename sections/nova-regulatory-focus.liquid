<section id="NovaRegulatory" class="nova-regulatory color-{{ section.settings.color_scheme }} gradient" aria-labelledby="NovaRegulatoryHeading-{{ section.id }}">
  <span class="nova-regulatory__watermark" aria-hidden="true">510(k)</span>
  <div class="page-width">
    <header class="nova-regulatory__header">
      <div>
        <span class="nova-regulatory__label">U.S. clearance &amp; quality</span>
        <h2 id="NovaRegulatoryHeading-{{ section.id }}">Documented standards.<br>Clear purchasing confidence.</h2>
      </div>
      <div>
        <p>Review the regulatory record, quality certification and product-level conformity information before ordering.</p>
        <a href="https://www.accessdata.fda.gov/scripts/cdrh/cfdocs/cfpmn/pmn.cfm?ID=K150363" target="_blank" rel="noopener">Verify on FDA.gov <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <div class="nova-regulatory__showcase">
      <article class="nova-regulatory__feature">
        <div class="nova-regulatory__feature-copy">
          <span>FDA device record</span>
          <div class="nova-regulatory__seal" aria-label="FDA 510(k) cleared">
            <span aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none"><path d="M16 3.5 6.5 7.7v7.4c0 6.4 3.8 11.8 9.5 14.2 5.7-2.4 9.5-7.8 9.5-14.2V7.7L16 3.5Z"/><path d="m11.3 16.1 3 3 6.7-7.4"/></svg>
            </span>
            <strong>FDA</strong>
            <small>510(k) cleared</small>
          </div>
          <h3>NOVA Dental Implants System</h3>
          <p>K150363 covers the NOVA Dental Implants System as a Class II endosseous dental implant and abutment system.</p>
          <div class="nova-regulatory__chips"><span>K150363</span><span>Class II</span><span>DZE / NHA</span></div>
        </div>
        <div class="nova-regulatory__feature-media" data-nova-depth>
          <img src="{{ 'nova-regulatory-lab-v1.jpg' | asset_url }}" alt="Precision medical-device quality-control laboratory" width="1693" height="929" loading="lazy">
          <span>Precision quality control</span>
        </div>
      </article>

      <div class="nova-regulatory__cards">
        <article>
          <span class="nova-regulatory__card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="10" r="6.5"/><path d="m8.5 15.4-1 5.1 4.5-2 4.5 2-1-5.1"/><path d="m9.3 10.1 1.8 1.8 3.8-4"/></svg></span>
          <span>Quality system</span><strong>ISO 13485:2016</strong><p>Certified medical-device quality management system · Registration IL-99180.</p>
        </article>
        <article>
          <span class="nova-regulatory__card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.5"/><path d="M3.8 12h16.4M12 3.5c2.4 2.3 3.6 5.1 3.6 8.5S14.4 18.2 12 20.5C9.6 18.2 8.4 15.4 8.4 12S9.6 5.8 12 3.5Z"/></svg></span>
          <span>Product conformity</span><strong>CE-marked lines</strong><p>Confirm current marking and applicability on the exact product label and IFU.</p>
        </article>
        <article>
          <span class="nova-regulatory__card-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3 5.5 5.8v5.1c0 4.4 2.6 8.1 6.5 9.8 3.9-1.7 6.5-5.4 6.5-9.8V5.8L12 3Z"/><path d="M9 12h6M12 9v6"/></svg></span>
          <span>Clinical access</span><strong>Professional use</strong><p>Intended for appropriately trained and licensed dental professionals.</p>
        </article>
      </div>
    </div>
    <p class="nova-regulatory__note">“FDA cleared” refers to the NOVA Dental Implants System covered by K150363; it does not mean FDA approval of every NOVA product. Always verify the label and applicable Instructions for Use for the exact item ordered.</p>
  </div>
</section>

{% schema %}
{
  "name": "NOVA regulatory focus",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [{ "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" }],
  "presets": [{ "name": "NOVA regulatory focus" }]
}
{% endschema %}
