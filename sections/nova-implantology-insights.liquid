{{ 'section-nova-implantology-insights.css' | asset_url | stylesheet_tag }}

<section class="nova-insights color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <header class="nova-insights__header">
      <div>
        <p class="nova-insights__eyebrow">NOVA journal · Product education</p>
        <h2>Learn more about dental implantology</h2>
      </div>
      <p>Reference content for dental professionals and laboratories—built around product identification, compatibility checks and clearer ordering.</p>
    </header>

    <div class="nova-insights__editorial">
      <a class="nova-insights__lead" href="/pages/psi-internal-hex-workflow">
        <span class="nova-insights__media"><img src="{{ 'nova-guide-psi-internal-hex.webp' | asset_url }}" alt="PSI internal-hex implant system components" width="1672" height="941" loading="lazy"></span>
        <span class="nova-insights__body">
          <span class="nova-insights__meta">Implant systems · 6 min read</span>
          <strong>Understanding the PSI Internal-Hex Workflow</strong>
          <span>Follow the connection from implant identification through restorative component selection.</span>
          <span class="nova-insights__link">Read the guide <span aria-hidden="true">→</span></span>
        </span>
      </a>

      <div class="nova-insights__rail">
        <a class="nova-insights__story" href="/pages/restorative-component-selection">
          <span class="nova-insights__story-media"><img src="{{ 'nova-guide-restorative-selection.webp' | asset_url }}" alt="NOVA restorative component selection" width="1672" height="941" loading="lazy"></span>
          <span class="nova-insights__story-copy">
            <span class="nova-insights__meta">Restorative workflow · 5 min read</span>
            <strong>Selecting Restorative Components by Catalog Reference</strong>
            <span>Compare interface, geometry and catalog details before ordering.</span>
            <span class="nova-insights__link">Read guide <span aria-hidden="true">→</span></span>
          </span>
        </a>
        <a class="nova-insights__story" href="/pages/surgical-kit-organization">
          <span class="nova-insights__story-media"><img src="{{ 'nova-guide-surgical-kit.webp' | asset_url }}" alt="Organized NOVA surgical instrument kit" width="1672" height="941" loading="lazy"></span>
          <span class="nova-insights__story-copy">
            <span class="nova-insights__meta">Instruments · 4 min read</span>
            <strong>Surgical Kit Organization and Instrument Identification</strong>
            <span>A catalog-focused overview of drills, drivers, mounts and torque instruments.</span>
            <span class="nova-insights__link">Read guide <span aria-hidden="true">→</span></span>
          </span>
        </a>
      </div>
    </div>

    <footer class="nova-insights__footer">
      <p>Professional education only. Always verify current labeling, IFU and compatibility before use.</p>
      <a href="{{ routes.all_products_collection_url }}">Explore the product catalog <span aria-hidden="true">→</span></a>
    </footer>
  </div>
</section>

{% schema %}
{
  "name": "NOVA insights",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "NOVA insights" }]
}
{% endschema %}
