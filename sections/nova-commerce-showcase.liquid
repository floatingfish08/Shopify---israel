{%- assign catalog_link = routes.all_products_collection_url -%}

<section id="NovaCatalog" class="nova-commerce color-{{ section.settings.color_scheme }} gradient" aria-labelledby="NovaCommerceHeading-{{ section.id }}">
  <div class="page-width">
    <header class="nova-commerce__heading">
      <div>
        <span class="nova-kicker">Shop by category</span>
        <h2 id="NovaCommerceHeading-{{ section.id }}" class="h1">Everything for one connected workflow.</h2>
      </div>
      <div>
        <p>Browse implant, healing, restorative, impression, digital, multi-unit and surgical solutions by clinical workflow or catalog number.</p>
        <a href="{{ catalog_link }}" class="nova-commerce__text-link">View 50+ products <span aria-hidden="true">→</span></a>
        <span class="nova-commerce__stat"><strong data-nova-count="7">7</strong> connected clinical categories</span>
      </div>
    </header>

    <div class="nova-commerce__categories" aria-label="Product categories">
      <a class="nova-category-card nova-category-card--wide" href="{{ routes.collections_url }}/implant-systems" data-nova-depth>
        <img src="{{ 'nova-category-implants.webp' | asset_url }}" alt="NOVA PSI dental implant system" width="1100" height="650" loading="lazy">
        <span class="nova-category-card__shade" aria-hidden="true"></span>
        <span class="nova-category-card__content">
          <span class="nova-category-card__number">01</span>
          <strong>PSI implant system</strong>
          <small>Multiple diameters and lengths</small>
        </span>
      </a>
      <a class="nova-category-card" href="{{ routes.collections_url }}/healing-abutments" data-nova-depth>
        <img src="{{ 'nova-category-healing.webp' | asset_url }}" alt="NOVA titanium healing abutments" width="900" height="650" loading="lazy">
        <span class="nova-category-card__shade" aria-hidden="true"></span>
        <span class="nova-category-card__content"><span class="nova-category-card__number">02</span><strong>Healing</strong><small>Standard, slim and concave</small></span>
      </a>
      <a class="nova-category-card" href="{{ routes.collections_url }}/restorative-components" data-nova-depth>
        <img src="{{ 'nova-category-restorative.webp' | asset_url }}" alt="NOVA restorative abutments" width="900" height="650" loading="lazy">
        <span class="nova-category-card__shade" aria-hidden="true"></span>
        <span class="nova-category-card__content"><span class="nova-category-card__number">03</span><strong>Restorative</strong><small>Temporary, PEEK and titanium</small></span>
      </a>
      <a class="nova-category-card" href="{{ routes.collections_url }}/impression-components" data-nova-depth>
        <img src="{{ 'nova-category-impression.webp' | asset_url }}" alt="NOVA impression components" width="900" height="650" loading="lazy">
        <span class="nova-category-card__shade" aria-hidden="true"></span>
        <span class="nova-category-card__content"><span class="nova-category-card__number">04</span><strong>Impression</strong><small>Open tray, closed tray and transfer</small></span>
      </a>
      <a class="nova-category-card" href="{{ routes.collections_url }}/multi-unit-overdenture" data-nova-depth>
        <img src="{{ 'nova-category-multi-unit.webp' | asset_url }}" alt="NOVA Multi Clicq and overdenture components" width="900" height="650" loading="lazy">
        <span class="nova-category-card__shade" aria-hidden="true"></span>
        <span class="nova-category-card__content"><span class="nova-category-card__number">05</span><strong>Multi-unit</strong><small>Full-arch and overdenture workflows</small></span>
      </a>
      <a class="nova-category-card" href="{{ routes.collections_url }}/digital-cad-cam-casting" data-nova-depth>
        <img src="{{ 'nova-category-digital.webp' | asset_url }}" alt="NOVA digital and CAD CAM components" width="900" height="650" loading="lazy">
        <span class="nova-category-card__shade" aria-hidden="true"></span>
        <span class="nova-category-card__content"><span class="nova-category-card__number">06</span><strong>Digital &amp; CAD/CAM</strong><small>Ti-base, scan body and casting</small></span>
      </a>
      <a class="nova-category-card" href="{{ routes.collections_url }}/surgical-instruments" data-nova-depth>
        <img src="{{ 'nova-category-surgical.webp' | asset_url }}" alt="NOVA surgical kit and instruments" width="900" height="650" loading="lazy">
        <span class="nova-category-card__shade" aria-hidden="true"></span>
        <span class="nova-category-card__content"><span class="nova-category-card__number">07</span><strong>Surgical</strong><small>Kits, drivers and hand tools</small></span>
      </a>
    </div>

    <div class="nova-commerce__footer">
      <p><strong>Not sure which component fits?</strong> Search by catalog number or ask the NOVA team to confirm compatibility.</p>
      <div>
        <a class="button button--primary" href="{{ catalog_link }}">Shop all products</a>
        <a class="button button--secondary" href="/pages/contact">Ask a product specialist</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NOVA commerce showcase",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "NOVA commerce showcase" }]
}
{% endschema %}
