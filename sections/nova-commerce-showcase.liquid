{%- assign catalog_link = routes.all_products_collection_url -%}

<section id="NovaCatalog" class="nova-commerce color-{{ section.settings.color_scheme }}" aria-labelledby="NovaCommerceHeading-{{ section.id }}">
  <div class="page-width">
    <header class="nova-commerce__heading">
      <span class="nova-kicker">Shop by category</span>
      <h2 id="NovaCommerceHeading-{{ section.id }}">One connected clinical workflow.</h2>
      <p>Implants, healing, restorative, impression, multi-unit, digital, and surgical — browse by use.</p>
    </header>

    <div class="nova-commerce__categories" aria-label="Product categories">
      <a class="nova-category-card nova-category-card--wide" href="{{ routes.collections_url }}/implant-systems">
        <img src="{{ 'nova-category-implants-premium-v2.webp' | asset_url }}" alt="NOVA PSI dental implant system" width="1672" height="941" loading="lazy">
        <span class="nova-category-card__content">
          <strong>PSI implant system</strong>
          <small>Multiple diameters and lengths</small>
        </span>
      </a>
      <a class="nova-category-card" href="{{ routes.collections_url }}/healing-abutments">
        <img src="{{ 'nova-category-healing-premium-v1.webp' | asset_url }}" alt="Titanium healing abutments" width="1672" height="941" loading="lazy">
        <span class="nova-category-card__content"><strong>Healing</strong><small>Standard, slim and concave</small></span>
      </a>
      <a class="nova-category-card" href="{{ routes.collections_url }}/restorative-components">
        <img src="{{ 'nova-category-restorative-premium-v1.webp' | asset_url }}" alt="Restorative abutments" width="1672" height="941" loading="lazy">
        <span class="nova-category-card__content"><strong>Restorative</strong><small>Temporary, PEEK and titanium</small></span>
      </a>
      <a class="nova-category-card" href="{{ routes.collections_url }}/impression-components">
        <img src="{{ 'nova-category-impression-premium-v1.webp' | asset_url }}" alt="Impression components" width="1672" height="941" loading="lazy">
        <span class="nova-category-card__content"><strong>Impression</strong><small>Open tray, closed tray and transfer</small></span>
      </a>
      <a class="nova-category-card" href="{{ routes.collections_url }}/multi-unit-overdenture">
        <img src="{{ 'nova-category-multi-unit-premium-v1.webp' | asset_url }}" alt="Multi-unit and overdenture components" width="1672" height="941" loading="lazy">
        <span class="nova-category-card__content"><strong>Multi-unit</strong><small>Full-arch and overdenture</small></span>
      </a>
      <a class="nova-category-card" href="{{ routes.collections_url }}/digital-cad-cam-casting">
        <img src="{{ 'nova-category-digital-premium-v1.webp' | asset_url }}" alt="Digital and CAD/CAM components" width="1672" height="941" loading="lazy">
        <span class="nova-category-card__content"><strong>Digital &amp; CAD/CAM</strong><small>Ti-base, scan body and casting</small></span>
      </a>
      <a class="nova-category-card" href="{{ routes.collections_url }}/surgical-instruments">
        <img src="{{ 'nova-category-surgical-premium-v1.webp' | asset_url }}" alt="Surgical instrument kit" width="1672" height="941" loading="lazy">
        <span class="nova-category-card__content"><strong>Surgical</strong><small>Kits, drivers and hand tools</small></span>
      </a>
    </div>

    <div class="nova-commerce__footer">
      <a class="button button--primary" href="{{ catalog_link }}">Shop all products</a>
      <a class="button button--secondary" href="/pages/contact">Ask a specialist</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NOVA commerce showcase",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "NOVA commerce showcase" }]
}
{% endschema %}
