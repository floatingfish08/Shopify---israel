{%- assign group_names = 'Implant systems||Healing abutments||Restorative components||Impression components||Multi-unit & overdenture||Digital, CAD/CAM & casting||Surgical instruments' | split: '||' -%}
{%- assign group_slugs = 'implants||healing||restorative||impression||multi-unit||digital||surgical' | split: '||' -%}

<section class="nova-directory" data-nova-catalog>
  <div class="nova-directory__hero" style="--nova-directory-art: url('{{ 'nova-implant-hero-v2.webp' | asset_url }}')">
    <div class="page-width nova-directory__hero-grid">
      <div>
        <p class="nova-eyebrow">NOVA clinical product range</p>
        <h1>NOVA Product Catalog</h1>
        <p class="nova-directory__lede">Browse 52 cataloged product families and 228 configurations for implant, restorative, digital and surgical workflows.</p>
        <div class="nova-directory__actions">
          <a class="button button--primary" href="{{ catalog_url }}" target="_blank" rel="noopener">Open complete PDF catalog</a>
          <a class="button button--secondary" href="/pages/contact">Request product information</a>
        </div>
      </div>
      <aside class="nova-directory__status" aria-label="Catalog status">
        <span>Catalog reference</span>
        <strong>2024 edition</strong>
        <p>Ordering and availability are confirmed directly by NOVA. Online checkout is not enabled for these clinical products.</p>
      </aside>
    </div>
  </div>

  <div class="page-width nova-directory__body">
    <div class="nova-directory__toolbar">
      <label class="nova-directory__search">
        <span class="visually-hidden">Search the product catalog</span>
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
        <input type="search" placeholder="Search a product family or catalog number" data-nova-catalog-search>
      </label>
      <p data-nova-catalog-count>52 product families</p>
    </div>

    <nav class="nova-directory__nav" aria-label="Catalog categories">
      {%- for group_name in group_names -%}
        <a href="#catalog-{{ group_slugs[forloop.index0] }}">{{ group_name }}</a>
      {%- endfor -%}
    </nav>

    <div class="nova-directory__groups">
      {%- for group_name in group_names -%}
        {%- case forloop.index0 -%}
          {%- when 0 -%}{%- assign group_items = implant_items -%}
          {%- when 1 -%}{%- assign group_items = healing_items -%}
          {%- when 2 -%}{%- assign group_items = restorative_items -%}
          {%- when 3 -%}{%- assign group_items = impression_items -%}
          {%- when 4 -%}{%- assign group_items = multi_items -%}
          {%- when 5 -%}{%- assign group_items = digital_items -%}
          {%- when 6 -%}{%- assign group_items = surgical_items -%}
        {%- endcase -%}
        {%- assign items = group_items | strip | split: '||' -%}
        <section class="nova-directory__group" id="catalog-{{ group_slugs[forloop.index0] }}" data-nova-catalog-group>
          <div class="nova-directory__group-heading">
            <span>{{ forloop.index | prepend: '0' }}</span>
            <div>
              <h2>{{ group_name }}</h2>
              <p>{{ items.size }} product {% if items.size == 1 %}family{% else %}families{% endif %}</p>
            </div>
          </div>
          <div class="nova-directory__grid">
            {%- for raw_item in items -%}
              {%- assign item = raw_item | split: '|' -%}
              <article class="nova-directory__card" data-nova-catalog-item data-search="{{ item[0] | append: ' ' | append: item[2] | downcase | escape }}">
                <div class="nova-directory__card-mark" aria-hidden="true">{{ item[0] | slice: 0 }}</div>
                <div>
                  <h3>{{ item[0] }}</h3>
                  <p>{{ item[2] }}</p>
                </div>
                <span class="nova-directory__variants">{{ item[1] }} {% if item[1] == '1' %}configuration{% else %}configurations{% endif %}</span>
              </article>
            {%- endfor -%}
          </div>
        </section>
      {%- endfor -%}
    </div>

    <p class="nova-directory__empty" data-nova-catalog-empty hidden>No catalog families match that search. Try a product name or catalog number.</p>

    <footer class="nova-directory__footer">
      <div>
        <p class="nova-eyebrow">Clinical documentation</p>
        <h2>Review specifications before use.</h2>
        <p>Product names and catalog numbers are transcribed from the supplied NOVA catalog. Trained professionals should confirm compatibility, current labeling and the applicable Instructions for Use.</p>
      </div>
      <div class="nova-directory__footer-actions">
        <a href="{{ catalog_url }}" target="_blank" rel="noopener">Product catalog <span aria-hidden="true">↗</span></a>
        <a href="{{ certificate_url }}" target="_blank" rel="noopener">ISO 13485 certificate <span aria-hidden="true">↗</span></a>
      </div>
    </footer>
  </div>
</section>

<script>
  (() => {
    const catalog = document.querySelector('[data-nova-catalog]');
    if (!catalog) return;
    const search = catalog.querySelector('[data-nova-catalog-search]');
    const cards = [...catalog.querySelectorAll('[data-nova-catalog-item]')];
    const groups = [...catalog.querySelectorAll('[data-nova-catalog-group]')];
    const count = catalog.querySelector('[data-nova-catalog-count]');
    const empty = catalog.querySelector('[data-nova-catalog-empty]');

    search.addEventListener('input', () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const match = !query || card.dataset.search.includes(query);
        card.hidden = !match;
        if (match) visible += 1;
      });
      groups.forEach((group) => {
        group.hidden = !group.querySelector('[data-nova-catalog-item]:not([hidden])');
      });
      count.textContent = `${visible} product ${visible === 1 ? 'family' : 'families'}`;
      empty.hidden = visible !== 0;
    });
  })();
</script>
