{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": { "type": "text", "settings": { "text": "{{ product.vendor }}", "text_style": "uppercase" } },
        "title": { "type": "title" },
        "sku": { "type": "sku", "settings": { "text_style": "body" } },
        "price": { "type": "price" },
        "inventory": {
          "type": "inventory",
          "settings": { "text_style": "body", "inventory_threshold": 10, "show_inventory_quantity": false }
        },
        "variant_picker": { "type": "variant_picker", "settings": { "picker_type": "button", "swatch_shape": "circle" } },
        "quantity_selector": { "type": "quantity_selector" },
        "buy_buttons": { "type": "buy_buttons", "settings": { "show_dynamic_checkout": true, "show_gift_card_recipient": false } },
        "clinical_assurance": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class='nova-product-assurance'><strong>Professional-use product</strong><span>Confirm compatibility and review the current product label and applicable Instructions for Use before clinical use. Controlled documents are available from the Clinical Resources area.</span></div>"
          }
        },
        "description": { "type": "description" },
        "specifications": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Specifications and compatibility",
            "icon": "ruler",
            "content": "<p>Use the selected variant, catalog number and product description to confirm dimensions and platform compatibility. Contact Nova before ordering if compatibility is uncertain.</p>",
            "page": ""
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping to the United States",
            "icon": "truck",
            "content": "<p>Orders dispatch from Israel using a tracked international service. The checkout rate and delivery estimate depend on destination, package weight and selected service. Delays outside the carrier's control may occur.</p>",
            "page": ""
          }
        },
        "share": { "type": "share", "settings": { "share_label": "Share" } }
      },
      "block_order": ["vendor", "title", "sku", "price", "inventory", "variant_picker", "quantity_selector", "buy_buttons", "clinical_assurance", "description", "specifications", "shipping", "share"],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 48,
        "padding_bottom": 24
      }
    },
    "disclosures": { "type": "disclosures", "settings": { "padding_top": 28, "padding_bottom": 8 } },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Compatible and related components",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-2",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": true,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 56,
        "padding_bottom": 56
      }
    }
  },
  "order": ["main", "disclosures", "related-products"]
}
