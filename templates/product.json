{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": { "type": "title" },
        "sku": { "type": "sku", "settings": { "text_style": "body" } },
        "price": { "type": "price" },
        "documents": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<a class='nova-product-document' href='https://cdn.shopify.com/s/files/1/0664/1988/4117/files/nova-implants-catalog-2026.pdf?v=1788246709' target='_blank' rel='noopener'><span aria-hidden='true'>PDF</span> View catalog &amp; product documents</a>"
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": { "text_style": "body", "inventory_threshold": 10, "show_inventory_quantity": false }
        },
        "variant_picker": { "type": "variant_picker", "settings": { "picker_type": "button", "swatch_shape": "circle" } },
        "quantity_selector": { "type": "quantity_selector" },
        "buy_buttons": { "type": "buy_buttons", "settings": { "show_dynamic_checkout": false, "show_gift_card_recipient": false } },
        "clinical_assurance": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class='nova-product-shipping'><span aria-hidden='true'>▰</span><strong>Free U.S. shipping on this order</strong></div><div class='nova-product-shipping__track'><i></i></div><div class='nova-product-assurance'><strong>Secure professional ordering</strong><small>Bank-transfer instructions are emailed after checkout. Orders remain pending until payment is confirmed.</small></div>"
          }
        },
        "description": { "type": "description" },
        "specifications": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Specifications and compatibility",
            "icon": "ruler",
            "content": "<p>Use the selected variant, catalog number and product description to confirm dimensions and platform compatibility. Contact Nova before ordering if compatibility is uncertain.</p>",
            "page": ""
          }
        },
        "shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping to the United States",
            "icon": "truck",
            "content": "<p>Free standard shipping is offered to U.S. destinations. Eligible in-stock orders received during fulfillment hours are dispatched the same business day. Carrier transit times begin after dispatch.</p>",
            "page": ""
          }
        },
        "share": { "type": "share", "settings": { "share_label": "Share" } }
      },
      "block_order": ["sku", "title", "price", "documents", "inventory", "variant_picker", "quantity_selector", "buy_buttons", "clinical_assurance", "share", "description", "specifications", "shipping"],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 20,
        "padding_bottom": 20
      }
    },
    "disclosures": { "type": "disclosures", "settings": { "padding_top": 28, "padding_bottom": 8 } },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Compatible and related components",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-2",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": true,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 56,
        "padding_bottom": 56
      }
    }
  },
  "order": ["main", "disclosures", "related-products"]
}
